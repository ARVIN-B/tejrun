# Copy to .env.social_media_chatbot. Keep all variable names app-scoped.
# Generate a Fernet key once and keep it stable across restarts and backups:
# .venv\\Scripts\\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_MEDIA_CHATBOT_ENCRYPTION_KEY=
SOCIAL_MEDIA_CHATBOT_LLM_API_KEY=
SOCIAL_MEDIA_CHATBOT_LLM_MODEL=
SOCIAL_MEDIA_CHATBOT_LLM_BASE_URL=
SOCIAL_MEDIA_CHATBOT_EVOLUTION_BASE_URL=http://127.0.0.1:8080
SOCIAL_MEDIA_CHATBOT_EVOLUTION_API_KEY=
SOCIAL_MEDIA_CHATBOT_PUBLIC_BASE_URL=https://your-domain.example.com
