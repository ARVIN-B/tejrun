# llm api key
AUTOGEN_API_KEY=
AUTOGEN_BASE_URL=https://openrouter.ai/api/v1
AUTOGEN_MODEL=nvidia/nemotron-3-super-120b-a12b:free

LLM_API_KEY=
LLM_API_KEY_2=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1


# LLM_API_KEY=replace-with-primary-groq-key
# LLM_MODEL=openai/gpt-oss-120b
# # LLM_MODEL=meta-llama/llama-prompt-guard-2-22m
# LLM_BASE_URL=https://openrouter.ai/api/v1


# telegram bot api
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY=http://127.0.0.1:62673

# database
DB_NAME=energy_project
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret

# Django
DEBUG=True
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Article Agent asynchronous execution
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
ARTICLE_AGENT_CELERY_CONCURRENCY=1
ARTICLE_AGENT_MAX_RETRIES=8
ARTICLE_AGENT_MAX_HEADING_LENGTH=255
ARTICLE_AGENT_RETRY_BACKOFF_SECONDS=60
ARTICLE_AGENT_MAX_SECTION_REVISIONS=2
ARTICLE_AGENT_WORD_COUNT_TOLERANCE=0.25
ARTICLE_AGENT_LLM_TIMEOUT_SECONDS=120
ARTICLE_AGENT_LLM_MAX_OUTPUT_TOKENS=2048
ARTICLE_AGENT_LLM_REVIEW_MAX_OUTPUT_TOKENS=1024
ARTICLE_AGENT_SPECIALIST_REVIEW_MAX_OUTPUT_TOKENS=700
ARTICLE_AGENT_SPECIALIST_REVIEW_MAX_FINDINGS=5
ARTICLE_AGENT_SPECIALIST_REVIEW_ROLES=seo,persian_editor,article_writer,industrial_electrical,solar
ARTICLE_AGENT_METADATA_MAX_OUTPUT_TOKENS=256
ARTICLE_AGENT_META_TITLE_MAX_LENGTH=60
ARTICLE_AGENT_META_DESCRIPTION_MAX_LENGTH=160
ARTICLE_AGENT_EMPTY_RESPONSE_RETRIES=1
ARTICLE_AGENT_OUTPUT_TOKENS_PER_WORD=2.0
# ARTICLE_AGENT_OUTPUT_TOKENS_PER_WORD=8.0
ARTICLE_AGENT_OUTPUT_TOKEN_BUFFER=128
# ARTICLE_AGENT_OUTPUT_TOKEN_BUFFER=1200
ARTICLE_AGENT_MAX_BUDGET_REPAIRS=3
ARTICLE_AGENT_RESEARCH_MODE=disabled
ARTICLE_AGENT_RESEARCH_URL=
ARTICLE_AGENT_RESEARCH_API_KEY=
ARTICLE_AGENT_GROQ_CONCURRENCY=2
ARTICLE_AGENT_GROQ_REQUESTS_PER_MINUTE=15
ARTICLE_AGENT_GROQ_TOKENS_PER_MINUTE=8000
# Set these only when the Groq project/account exposes separate ITPM/OTPM limits.
ARTICLE_AGENT_GROQ_INPUT_TOKENS_PER_MINUTE=
ARTICLE_AGENT_GROQ_OUTPUT_TOKENS_PER_MINUTE=
# Namespace must identify one shared API-key/project quota in the shared Redis instance.
ARTICLE_AGENT_GROQ_QUOTA_NAMESPACE=default
ARTICLE_AGENT_GROQ_SAFETY_MARGIN=0.90
ARTICLE_AGENT_GROQ_LEASE_SECONDS=150
# A long-form job can include several bounded LLM calls, revisions and a
# provider quota wait. Soft limit: 6h; hard limit: 6h15m.
ARTICLE_AGENT_TASK_SOFT_TIME_LIMIT=21600
ARTICLE_AGENT_TASK_TIME_LIMIT=22500
# LLM_MODEL remains supported. Model IDs must be enabled for this Groq project.
ARTICLE_AGENT_PRIMARY_MODEL=openai/gpt-oss-120b
# ARTICLE_AGENT_PRIMARY_MODEL=meta-llama/llama-prompt-guard-2-22m
ARTICLE_AGENT_FALLBACK_MODELS=openai/gpt-oss-120b
ARTICLE_AGENT_REVIEW_MODEL=openai/gpt-oss-120b
ARTICLE_AGENT_FALLBACK_ON_PROVIDER_429=true
# Retry a real provider 429 once with LLM_API_KEY_2. This only helps when the
# second key belongs to a separate organization/project quota.
ARTICLE_AGENT_ENABLE_SECONDARY_API_KEY_FALLBACK=true
# Number of credential slots inspected: LLM_API_KEY, then LLM_API_KEY_2...N.
# A TPD/token-per-day 429 tries each configured slot once before Celery retries.
ARTICLE_AGENT_API_KEY_SLOTS=5
ARTICLE_AGENT_FALLBACK_ON_TRANSIENT_FAILURES=false
# Must match the context window of the model configured below. The application
# reserves room for the completion and splits long sections before this limit.
ARTICLE_AGENT_LLM_CONTEXT_WINDOW_TOKENS=8192
ARTICLE_AGENT_LLM_CONTEXT_SAFETY_TOKENS=256
ARTICLE_AGENT_LLM_PROMPT_OVERHEAD_TOKENS=512
# Optional per-model caps; do not copy account-wide values into every model.
# Example: {"openai/gpt-oss-120b":{"rpm":30,"tpm":8000}}
ARTICLE_AGENT_GROQ_MODEL_LIMITS={}

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com
